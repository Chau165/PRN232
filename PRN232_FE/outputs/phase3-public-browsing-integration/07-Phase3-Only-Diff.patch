+      if (url.pathname === "/api/public/properties/17/rooms")
+        return Promise.resolve(
+          jsonResponse(
+            page([room(), room({ roomId: 502, roomCode: "R-502" })]),
+          ),
+        )
+      if (url.pathname === "/api/public/rooms/502")
+        return Promise.resolve(jsonResponse({ title: "Not Found" }, 404))
+      return Promise.resolve(
