+    expect(within(dialog).queryByText("R-501")).toBeNull()
+    expect(
+      within(dialog)
+        .getByRole("button", { name: /Đặt cọc trực tuyến/ })
+        .hasAttribute("disabled"),
+    ).toBe(true)
+    expect(
+      within(dialog)
+        .getByRole("button", { name: /Đặt lịch xem/ })
+        .hasAttribute("disabled"),
+    ).toBe(true)
+    expect(dialog.querySelector("img")).toBeNull()
