@@ -0,0 +1,244 @@
+import { useEffect, useRef, useState } from "react"
+
+import L, { type Marker as LeafletMarker } from "leaflet"
+import {
+  CircleMarker,
+  MapContainer,
+  Marker,
+  Popup,
+  TileLayer,
+  useMap,
+} from "react-leaflet"
+import { Link } from "react-router"
+import "leaflet/dist/leaflet.css"
+
+import type { PublicPropertyAreaCard } from "@/api/publicBrowsingApi"
+import { propertyDetailPath } from "@/constants/routes"
+import { formatVnd } from "@/utils/publicFormatting"
+import {
+  buildGoogleMapsDirectionsUrl,
+  type AreaCoordinates,
+} from "@/utils/areaDiscovery"
+
+interface AreaPropertyMapProps {
+  properties: PublicPropertyAreaCard[]
+  center: AreaCoordinates
+  selectedPropertyId: number | null
+  onSelect: (propertyId: number) => void
+}
+
+function hasMapCoordinates(property: PublicPropertyAreaCard): boolean {
+  return (
+    Number.isFinite(property.latitude) &&
+    Number.isFinite(property.longitude) &&
+    property.latitude >= -90 &&
+    property.latitude <= 90 &&
+    property.longitude >= -180 &&
+    property.longitude <= 180 &&
+    (property.latitude !== 0 || property.longitude !== 0)
+  )
+}
+
+function escapeHtml(value: string): string {
+  return value.replace(/[&<>"']/g, (character) => {
+    const escaped: Record<string, string> = {
+      "&": "&amp;",
+      "<": "&lt;",
+      ">": "&gt;",
+      '"': "&quot;",
+      "'": "&#39;",
+    }
+    return escaped[character] ?? character
+  })
+}
+
+function safeImageUrl(value: string | null): string | null {
+  const imageUrl = value?.trim()
+  if (!imageUrl) return null
+  if (imageUrl.startsWith("/")) return imageUrl
+
+  try {
+    const parsed = new URL(imageUrl)
+    return parsed.protocol === "https:" || parsed.protocol === "http:"
+      ? parsed.toString()
+      : null
+  } catch {
+    return null
+  }
+}
+
+function markerIcon(
+  property: PublicPropertyAreaCard,
+  selected: boolean,
+): L.DivIcon {
+  const imageUrl = safeImageUrl(property.primaryImageUrl)
+  const image = imageUrl
+    ? `<img class="area-property-marker__image" src="${escapeHtml(imageUrl)}" alt="" loading="lazy" />`
+    : `<span class="area-property-marker__placeholder" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5M5.5 9.5v11h13v-11M9 20.5v-7h6v7" /></svg></span>`
+
+  return L.divIcon({
+    className: `area-property-marker${selected ? " area-property-marker--selected" : ""}`,
+    html: `<span class="area-property-marker__card"><span class="area-property-marker__photo">${image}</span><span class="area-property-marker__price">${escapeHtml(formatVnd(property.startingPrice))}</span></span>`,
+    iconSize: [142, 78],
+    iconAnchor: [71, 78],
+    popupAnchor: [0, -74],
+  })
+}
+
+function MapViewport({
+  properties,
+  center,
+  selectedPropertyId,
+  markerRefs,
+}: AreaPropertyMapProps & {
+  markerRefs: React.MutableRefObject<Map<number, LeafletMarker>>
+}) {
+  const map = useMap()
+
+  useEffect(() => {
+    if (selectedPropertyId !== null) return
+
+    const points: L.LatLngTuple[] = [
+      [center.latitude, center.longitude],
+      ...properties
+        .filter(hasMapCoordinates)
+        .map((property): L.LatLngTuple => [property.latitude, property.longitude]),
+    ]
+    map.fitBounds(points, { padding: [44, 44], maxZoom: 14 })
+  }, [center, map, properties, selectedPropertyId])
+
+  useEffect(() => {
+    if (selectedPropertyId === null) return
+    const property = properties.find((item) => item.propertyId === selectedPropertyId)
+    if (!property || !hasMapCoordinates(property)) return
+
+    map.flyTo(
+      [property.latitude, property.longitude],
+      Math.max(map.getZoom(), 14),
+      { duration: 0.45 },
+    )
+    markerRefs.current.get(property.propertyId)?.openPopup()
+  }, [map, markerRefs, properties, selectedPropertyId])
+
+  return null
+}
+
+export default function AreaPropertyMap({
+  properties,
+  center,
+  selectedPropertyId,
+  onSelect,
+}: AreaPropertyMapProps) {
+  const markerRefs = useRef(new Map<number, LeafletMarker>())
+  const [tileError, setTileError] = useState(false)
+  const tileUrl =
+    import.meta.env.VITE_PUBLIC_MAP_TILE_URL ||
+    "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
+  const attribution =
+    import.meta.env.VITE_PUBLIC_MAP_ATTRIBUTION ||
+    '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap contributors</a>'
+
+  return (
+    <div className="overflow-hidden rounded-2xl border border-slate-200 bg-white">
+      <MapContainer
+        center={[center.latitude, center.longitude]}
+        zoom={13}
+        minZoom={5}
+        maxZoom={18}
+        scrollWheelZoom={false}
+        className="h-[390px] w-full sm:h-[470px]"
+      >
+        <MapViewport
+          properties={properties}
+          center={center}
+          selectedPropertyId={selectedPropertyId}
+          onSelect={onSelect}
+          markerRefs={markerRefs}
+        />
+        <TileLayer
+          url={tileUrl}
+          attribution={attribution}
+          eventHandlers={{ tileerror: () => setTileError(true) }}
+        />
+        <CircleMarker
+          center={[center.latitude, center.longitude]}
+          radius={8}
+          pathOptions={{ color: "#ffffff", fillColor: "#087775", fillOpacity: 1, weight: 3 }}
+        >
+          <Popup>Vị trí hiện tại của bạn</Popup>
+        </CircleMarker>
+        {properties.filter(hasMapCoordinates).map((property) => {
+          const selected = property.propertyId === selectedPropertyId
+          const directionsUrl = buildGoogleMapsDirectionsUrl(property)
+          return (
+            <Marker
+              key={property.propertyId}
+              ref={(marker) => {
+                if (marker) markerRefs.current.set(property.propertyId, marker)
+                else markerRefs.current.delete(property.propertyId)
+              }}
+              position={[property.latitude, property.longitude]}
+              icon={markerIcon(property, selected)}
+              title={`${property.propertyName} · ${formatVnd(property.startingPrice)}`}
+              alt={`${property.propertyName}, ${formatVnd(property.startingPrice)}`}
+              zIndexOffset={selected ? 1000 : 0}
+              eventHandlers={{ click: () => onSelect(property.propertyId) }}
+            >
+              <Popup className="area-property-popup" maxWidth={290} minWidth={250}>
+                <div className="space-y-2 p-1">
+                  <h3 className="font-bold text-slate-900">{property.propertyName}</h3>
+                  <p className="text-xs leading-5 text-slate-600">
+                    {[property.addressText, property.ward, property.district, property.city]
+                      .filter(Boolean)
+                      .join(", ")}
+                  </p>
+                  <p className="text-xs text-slate-600">
+                    Còn {property.availableRoomCount} phòng đang cho thuê
+                  </p>
+                  <p className="font-bold text-[#087775]">
+                    {formatVnd(property.startingPrice)}
+                    <span className="ml-1 text-xs font-medium text-slate-500">/tháng từ</span>
+                  </p>
+                  <div className="flex gap-2 pt-1">
+                    <Link
+                      to={propertyDetailPath(property.propertyId)}
+                      className="rounded-lg bg-[#087775] px-3 py-2 text-xs font-bold text-white hover:bg-[#066a68]"
+                    >
+                      Xem chi tiết
+                    </Link>
+                    {directionsUrl && (
+                      <a
+                        href={directionsUrl}
+                        target="_blank"
+                        rel="noopener noreferrer"
+                        className="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50"
+                      >
+                        Chỉ đường
+                      </a>
+                    )}
+                  </div>
+                </div>
+              </Popup>
+            </Marker>
+          )
+        })}
+      </MapContainer>
+      {tileError && (
+        <p role="status" className="border-t border-slate-100 px-4 py-2 text-xs text-amber-700">
+          Nền bản đồ chưa tải được. Danh sách khu trọ vẫn sử dụng được.
+        </p>
+      )}
+      <p className="flex items-center justify-between gap-3 border-t border-slate-100 px-4 py-2 text-[11px] text-slate-500">
+        <span>Bản đồ © OpenStreetMap contributors</span>
+        <a
+          href="https://www.openstreetmap.org/fixthemap"
+          target="_blank"
+          rel="noopener noreferrer"
+          className="font-semibold text-[#087775] hover:underline"
+        >
+          Báo lỗi bản đồ
+        </a>
+      </p>
+    </div>
+  )
+}
diff --git a/PRN232_FE/src/utils/areaDiscovery.ts b/PRN232_FE/src/utils/areaDiscovery.ts
new file mode 100644
index 0000000..3114082
--- /dev/null
+++ b/PRN232_FE/src/utils/areaDiscovery.ts
@@ -0,0 +1,337 @@
+import type {
+  PublicPropertyAreaCard,
+  PublicPropertyAreaQuery,
+} from "@/api/publicBrowsingApi"
+
+export interface AreaCoordinates {
+  latitude: number
+  longitude: number
+}
+
+export interface ResolvedArea {
+  district?: string
+  ward?: string
+  city?: string
+}
+
+export type MatchedAreaLevel = "district" | "ward" | "city"
+export type AreaDiscoveryStep = "location" | "reverse-geocode" | "properties"
+export type AreaDiscoveryErrorKind =
+  | "location-unavailable"
+  | "permission-denied"
+  | "reverse-geocode"
+  | "area-api"
+
+export interface AreaDiscoveryResult {
+  coordinates: AreaCoordinates
+  area: ResolvedArea
+  matchedLevel: MatchedAreaLevel
+  usedCityFallback: boolean
+  properties: PublicPropertyAreaCard[]
+}
+
+interface DiscoverCurrentAreaOptions {
+  geolocation: Geolocation | null
+  fetchImplementation: typeof fetch
+  listPropertiesByArea: (
+    query: PublicPropertyAreaQuery,
+    signal?: AbortSignal,
+  ) => Promise<PublicPropertyAreaCard[]>
+  onProgress?: (step: AreaDiscoveryStep) => void
+  signal?: AbortSignal
+}
+
+interface ReverseGeocodeResponse {
+  address?: Record<string, unknown>
+}
+
+export class AreaDiscoveryError extends Error {
+  constructor(readonly kind: AreaDiscoveryErrorKind, message: string) {
+    super(message)
+    this.name = "AreaDiscoveryError"
+  }
+}
+
+function isAbortError(error: unknown): boolean {
+  return (
+    typeof error === "object" &&
+    error !== null &&
+    "name" in error &&
+    (error as { name?: unknown }).name === "AbortError"
+  )
+}
+
+function readLocationName(
+  address: Record<string, unknown>,
+  candidates: readonly string[],
+): string | undefined {
+  for (const candidate of candidates) {
+    const value = address[candidate]
+    if (typeof value === "string" && value.trim()) return value.trim()
+  }
+  return undefined
+}
+
+function areaFromReverseGeocode(response: unknown): ResolvedArea {
+  if (typeof response !== "object" || response === null || !("address" in response)) {
+    throw new AreaDiscoveryError(
+      "reverse-geocode",
+      "Không xác định được khu vực hiện tại từ vị trí.",
+    )
+  }
+
+  const address = (response as ReverseGeocodeResponse).address
+  if (!address || typeof address !== "object") {
+    throw new AreaDiscoveryError(
+      "reverse-geocode",
+      "Không xác định được khu vực hiện tại từ vị trí.",
+    )
+  }
+
+  const area: ResolvedArea = {
+    district: readLocationName(address, [
+      "city_district",
+      "district",
+      "county",
+      "state_district",
+    ]),
+    ward: readLocationName(address, [
+      "ward",
+      "suburb",
+      "quarter",
+      "neighbourhood",
+      "city_subdivision",
+    ]),
+    city: readLocationName(address, [
+      "city",
+      "town",
+      "municipality",
+      "province",
+      "state",
+    ]),
+  }
+
+  if (!area.district && !area.ward && !area.city) {
+    throw new AreaDiscoveryError(
+      "reverse-geocode",
+      "Không xác định được khu vực hiện tại từ vị trí.",
+    )
+  }
+
+  return area
+}
+
+function getCurrentCoordinates(geolocation: Geolocation | null): Promise<AreaCoordinates> {
+  if (!geolocation) {
+    return Promise.reject(
+      new AreaDiscoveryError(
+        "location-unavailable",
+        "Trình duyệt này không hỗ trợ lấy vị trí hiện tại.",
+      ),
+    )
+  }
+
+  return new Promise((resolve, reject) => {
+    geolocation.getCurrentPosition(
+      (position) => {
+        const { latitude, longitude } = position.coords
+        if (
+          !Number.isFinite(latitude) ||
+          !Number.isFinite(longitude) ||
+          latitude < -90 ||
+          latitude > 90 ||
+          longitude < -180 ||
+          longitude > 180
+        ) {
+          reject(
+            new AreaDiscoveryError(
+              "location-unavailable",
+              "Trình duyệt trả về vị trí không hợp lệ.",
+            ),
+          )
+          return
+        }
+        resolve({ latitude, longitude })
+      },
+      (error) => {
+        reject(
+          error.code === 1
+            ? new AreaDiscoveryError(
+                "permission-denied",
+                "Bạn đã từ chối quyền vị trí. Hãy bật quyền vị trí trong trình duyệt rồi thử lại.",
+              )
+            : new AreaDiscoveryError(
+                "location-unavailable",
+                "Không thể lấy vị trí hiện tại. Hãy kiểm tra dịch vụ vị trí rồi thử lại.",
+              ),
+        )
+      },
+      { enableHighAccuracy: false, maximumAge: 120_000, timeout: 15_000 },
+    )
+  })
+}
+
+async function reverseGeocode(
+  coordinates: AreaCoordinates,
+  fetchImplementation: typeof fetch,
+  signal?: AbortSignal,
+): Promise<ResolvedArea> {
+  const endpoint =
+    import.meta.env.VITE_REVERSE_GEOCODING_URL?.trim() ||
+    "https://nominatim.openstreetmap.org/reverse"
+  let url: URL
+  try {
+    url = new URL(endpoint)
+    if (url.protocol !== "https:" && url.protocol !== "http:") {
+      throw new Error("unsupported protocol")
+    }
+  } catch {
+    throw new AreaDiscoveryError(
+      "reverse-geocode",
+      "Cấu hình dịch vụ xác định khu vực không hợp lệ.",
+    )
+  }
+
+  url.searchParams.set("format", "jsonv2")
+  url.searchParams.set("lat", String(coordinates.latitude))
+  url.searchParams.set("lon", String(coordinates.longitude))
+  url.searchParams.set("zoom", "10")
+  url.searchParams.set("addressdetails", "1")
+
+  let response: Response
+  try {
+    response = await fetchImplementation(url.toString(), {
+      method: "GET",
+      headers: { Accept: "application/json", "Accept-Language": "vi" },
+      credentials: "omit",
+      cache: "default",
+      signal,
+    })
+  } catch (error) {
+    if (isAbortError(error)) throw error
+    throw new AreaDiscoveryError(
+      "reverse-geocode",
+      "Không thể kết nối dịch vụ xác định khu vực. Vui lòng thử lại.",
+    )
+  }
+
+  if (!response.ok) {
+    throw new AreaDiscoveryError(
+      "reverse-geocode",
+      "Không xác định được khu vực hiện tại vì dịch vụ đang tạm thời không khả dụng.",
+    )
+  }
+
+  try {
+    return areaFromReverseGeocode(await response.json())
+  } catch (error) {
+    if (error instanceof AreaDiscoveryError) throw error
+    throw new AreaDiscoveryError(
+      "reverse-geocode",
+      "Dữ liệu khu vực nhận được không hợp lệ.",
+    )
+  }
+}
+
+async function loadProperties(
+  query: PublicPropertyAreaQuery,
+  listPropertiesByArea: DiscoverCurrentAreaOptions["listPropertiesByArea"],
+  signal?: AbortSignal,
+): Promise<PublicPropertyAreaCard[]> {
+  try {
+    return await listPropertiesByArea(query, signal)
+  } catch (error) {
+    if (isAbortError(error)) throw error
+    throw new AreaDiscoveryError(
+      "area-api",
+      "Không tải được danh sách khu trọ. Vui lòng thử lại.",
+    )
+  }
+}
+
+export async function discoverCurrentArea({
+  geolocation,
+  fetchImplementation,
+  listPropertiesByArea,
+  onProgress,
+  signal,
+}: DiscoverCurrentAreaOptions): Promise<AreaDiscoveryResult> {
+  onProgress?.("location")
+  const coordinates = await getCurrentCoordinates(geolocation)
+
+  onProgress?.("reverse-geocode")
+  const area = await reverseGeocode(coordinates, fetchImplementation, signal)
+
+  const initialQuery: PublicPropertyAreaQuery = area.district
+    ? { district: area.district, ...(area.city ? { city: area.city } : {}) }
+    : area.ward
+      ? { ward: area.ward, ...(area.city ? { city: area.city } : {}) }
+      : { city: area.city }
+  const initialLevel: MatchedAreaLevel = area.district
+    ? "district"
+    : area.ward
+      ? "ward"
+      : "city"
+
+  onProgress?.("properties")
+  const areaProperties = await loadProperties(
+    initialQuery,
+    listPropertiesByArea,
+    signal,
+  )
+  if (areaProperties.length > 0 || !area.city || initialLevel === "city") {
+    return {
+      coordinates,
+      area,
+      matchedLevel: initialLevel,
+      usedCityFallback: false,
+      properties: areaProperties,
+    }
+  }
+
+  const cityProperties = await loadProperties(
+    { city: area.city },
+    listPropertiesByArea,
+    signal,
+  )
+  return {
+    coordinates,
+    area,
+    matchedLevel: "city",
+    usedCityFallback: true,
+    properties: cityProperties,
+  }
+}
+
+export function buildGoogleMapsDirectionsUrl(
+  property: Pick<
+    PublicPropertyAreaCard,
+    "latitude" | "longitude" | "addressText" | "ward" | "district" | "city"
+  >,
+): string | null {
+  const hasUsableCoordinates =
+    Number.isFinite(property.latitude) &&
+    Number.isFinite(property.longitude) &&
+    property.latitude >= -90 &&
+    property.latitude <= 90 &&
+    property.longitude >= -180 &&
+    property.longitude <= 180 &&
+    (property.latitude !== 0 || property.longitude !== 0)
+
+  const address = [
+    property.addressText,
+    property.ward,
+    property.district,
+    property.city,
+  ]
+    .filter((part): part is string => typeof part === "string" && part.trim().length > 0)
+    .map((part) => part.trim())
+    .join(", ")
+  const destination = hasUsableCoordinates
+    ? `${property.latitude},${property.longitude}`
+    : address
+  if (!destination) return null
+
+  const parameters = new URLSearchParams({ api: "1", destination })
+  return `https://www.google.com/maps/dir/?${parameters.toString()}`
+}
