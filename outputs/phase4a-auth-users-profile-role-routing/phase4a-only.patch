+      <AuthProvider>
+        <ProtectedRoute roles={["ADMIN"]}>{page}</ProtectedRoute>
+      </AuthProvider>
+    </MemoryRouter>,
+  )
+}
+
+beforeEach(() => window.sessionStorage.clear())
