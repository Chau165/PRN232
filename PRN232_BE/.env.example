# Copy file này thành ".env" (không commit .env thật) rồi điền giá trị thật để
# chạy local qua docker-compose, hoặc copy từng dòng vào Railway > Variables khi deploy.
# Local dev không dùng Docker thì cấu hình qua `dotnet user-secrets` thay vì file này
# (xem README.md) để tránh gõ nhầm secret vào git.

CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=xxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=xxx;SSL Mode=Require;Trust Server Certificate=true
JWT__KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT__ISSUER=PRN232_BE
JWT__AUDIENCE=PRN232_FE
CORS__ALLOWEDORIGINS__0=http://localhost:5173
