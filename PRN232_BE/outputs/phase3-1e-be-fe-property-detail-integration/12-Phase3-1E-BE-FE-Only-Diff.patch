diff --git a/PRN232_FE/src/utils/publicFormatting.ts b/PRN232_FE/src/utils/publicFormatting.ts
index bb84add..acbbab8 100644
--- a/PRN232_FE/src/utils/publicFormatting.ts
+++ b/PRN232_FE/src/utils/publicFormatting.ts
@@ -9,3 +9,18 @@ export function formatVnd(value: number | null | undefined): string {
     maximumFractionDigits: 2,
   }).format(value)
 }
+
+export function serviceRateUnitLabel(
+  unitCode: string,
+  billingBasis: string,
+): string | null {
+  const unitLabels: Record<string, string> = {
+    "kwh:usage": "kWh",
+    "m3:usage": "m³",
+    "room_month:fixed_room": "phòng/tháng",
+    "person_month:occupant": "người/tháng",
+    "vehicle_month:vehicle": "xe/tháng",
+  }
+
+  return unitLabels[`${unitCode}:${billingBasis}`] ?? null
+}

