+using PRN232.Application.DTOs;
+using PRN232.Application.Interfaces;
+
+namespace PRN232.Application.Services;
+
+public sealed class PublicPropertyListingService : IPublicPropertyListingService
+{
+    private const int DefaultPage = 1;
+    private const int DefaultPageSize = 10;
+    private const int MaximumPageSize = 50;
+    private const int MaximumAmenityIds = 20;
+    private static readonly string[] SupportedSorts = ["propertyid", "price_asc", "price_desc"];
+
+    private readonly IPublicPropertyListingRepository _repository;
+    private readonly TimeProvider _timeProvider;
+
+    public PublicPropertyListingService(
+        IPublicPropertyListingRepository repository,
+        TimeProvider timeProvider)
+    {
+        _repository = repository;
+        _timeProvider = timeProvider;
+    }
+
+    public async Task<PublicPropertyPageDto> GetAllAsync(
+        PublicPropertyQueryDto query,
+        CancellationToken cancellationToken)
+    {
+        var criteria = NormalizeAndValidate(query);
+        if (criteria.AmenityIds.Length > 0 &&
+            !await _repository.AmenityIdsExistAsync(criteria.AmenityIds, cancellationToken))
+        {
+            throw new PublicPropertyQueryValidationException("amenityIds", "One or more amenity IDs do not exist.");
+        }
+
+        var asOfUtc = _timeProvider.GetUtcNow().ToUniversalTime();
+        return await _repository.GetPageAsync(criteria, asOfUtc, cancellationToken);
+    }
+
+    private static PublicPropertySearchCriteria NormalizeAndValidate(PublicPropertyQueryDto query)
+    {
+        var page = query.Page ?? DefaultPage;
+        if (page < 1)
+        {
+            throw new PublicPropertyQueryValidationException("page", "Page must be at least 1.");
+        }
+
+        var pageSize = query.PageSize ?? DefaultPageSize;
+        if (pageSize is < 1 or > MaximumPageSize)
+        {
+            throw new PublicPropertyQueryValidationException("pageSize", $"Page size must be between 1 and {MaximumPageSize}.");
+        }
+
+        var offset = (long)(page - 1) * pageSize;
+        if (offset > int.MaxValue)
+        {
+            throw new PublicPropertyQueryValidationException("page", "Page is too large.");
+        }
+
+        if (query.MinPrice < 0)
+        {
+            throw new PublicPropertyQueryValidationException("minPrice", "Minimum price cannot be negative.");
+        }
+        if (query.MaxPrice < 0)
+        {
+            throw new PublicPropertyQueryValidationException("maxPrice", "Maximum price cannot be negative.");
+        }
+        if (query.MinPrice is not null && query.MaxPrice is not null && query.MinPrice > query.MaxPrice)
+        {
+            throw new PublicPropertyQueryValidationException("maxPrice", "Maximum price must be greater than or equal to minimum price.");
+        }
+
+        var submittedAmenityIds = query.AmenityIds ?? [];
+        if (submittedAmenityIds.Length > MaximumAmenityIds)
+        {
+            throw new PublicPropertyQueryValidationException("amenityIds", $"At most {MaximumAmenityIds} amenity IDs may be supplied.");
+        }
+        if (submittedAmenityIds.Any(amenityId => amenityId <= 0))
+        {
+            throw new PublicPropertyQueryValidationException("amenityIds", "Amenity IDs must be positive integers.");
+        }
+
+        var amenityIds = submittedAmenityIds.Distinct().Order().ToArray();
+        var sortBy = NormalizeText(query.SortBy)?.ToLowerInvariant() ?? "propertyid";
+        if (!SupportedSorts.Contains(sortBy, StringComparer.Ordinal))
+        {
+            throw new PublicPropertyQueryValidationException("sortBy", "Sort must be propertyId, price_asc, or price_desc.");
+        }
+
+        return new PublicPropertySearchCriteria(
+            NormalizeText(query.Keyword),
+            NormalizeText(query.City),
+            NormalizeText(query.District),
+            NormalizeText(query.Ward),
+            query.MinPrice,
+            query.MaxPrice,
+            NormalizeText(query.RoomTypeName),
+            amenityIds,
+            sortBy,
+            page,
+            pageSize,
+            (int)offset);
+    }
+
+    private static string? NormalizeText(string? value) =>
+        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
+}
+
+public sealed class PublicPropertyQueryValidationException(string field, string message) : Exception(message)
+{
+    public string Field { get; } = field;
+}
diff --git a/PRN232_BE/PRN232.Infrastructure/Repositories/PublicPropertyListingRepository.cs b/PRN232_BE/PRN232.Infrastructure/Repositories/PublicPropertyListingRepository.cs
new file mode 100644
index 0000000..afe4518
--- /dev/null
+++ b/PRN232_BE/PRN232.Infrastructure/Repositories/PublicPropertyListingRepository.cs
@@ -0,0 +1,195 @@
+using System.Data;
+using Microsoft.EntityFrameworkCore;
+using PRN232.Application.DTOs;
+using PRN232.Application.Interfaces;
+using PRN232.Domain.Entities;
+using PRN232.Infrastructure.Data;
+
+namespace PRN232.Infrastructure.Repositories;
+
+public sealed class PublicPropertyListingRepository : IPublicPropertyListingRepository
+{
+    private const int MaximumAmenitiesSummary = 5;
+
+    private readonly AppDbContext _context;
+
+    public PublicPropertyListingRepository(AppDbContext context)
+    {
+        _context = context;
+    }
+
+    public async Task<bool> AmenityIdsExistAsync(int[] amenityIds, CancellationToken cancellationToken) =>
+        await _context.Amenities
+            .AsNoTracking()
+            .Where(amenity => amenityIds.Contains(amenity.AmenityId))
+            .Select(amenity => amenity.AmenityId)
+            .Distinct()
+            .CountAsync(cancellationToken) == amenityIds.Length;
+
+    public async Task<PublicPropertyPageDto> GetPageAsync(
+        PublicPropertySearchCriteria criteria,
+        DateTimeOffset asOfUtc,
+        CancellationToken cancellationToken)
+    {
+        await using var transaction = _context.Database.IsRelational()
+            ? await _context.Database.BeginTransactionAsync(IsolationLevel.RepeatableRead, cancellationToken)
+            : null;
+
+        var matchingRooms = ApplyRoomFilters(
+            RoomAvailabilityQueries.GetRentableRooms(_context.Rooms, asOfUtc),
+            criteria);
+        var eligibleProperties = ApplyPropertyFilters(_context.Properties.AsNoTracking(), criteria)
+            .Where(property => matchingRooms.Any(room => room.PropertyId == property.PropertyId));
+
+        var totalCount = await eligibleProperties.CountAsync(cancellationToken);
+        var listingRows = eligibleProperties.Select(property => new
+        {
+            property.PropertyId,
+            property.PropertyName,
+            property.AddressText,
+            property.Ward,
+            property.District,
+            property.City,
+            AvailableRoomCount = matchingRooms
+                .Where(room => room.PropertyId == property.PropertyId)
+                .Select(room => room.RoomId)
+                .Distinct()
+                .Count(),
+            StartingPrice = matchingRooms
+                .Where(room => room.PropertyId == property.PropertyId)
+                .Select(room => (decimal?)room.RoomType!.Price)
+                .Min(),
+            RepresentativeRoomId = matchingRooms
+                .Where(room => room.PropertyId == property.PropertyId)
+                .OrderBy(room => room.RoomType!.Price)
+                .ThenBy(room => room.RoomId)
+                .Select(room => (int?)room.RoomId)
+                .FirstOrDefault()
+        });
+
+        var orderedRows = criteria.SortBy switch
+        {
+            "price_asc" => listingRows
+                .OrderBy(row => row.StartingPrice)
+                .ThenBy(row => row.PropertyId),
+            "price_desc" => listingRows
+                .OrderByDescending(row => row.StartingPrice)
+                .ThenBy(row => row.PropertyId),
+            _ => listingRows.OrderBy(row => row.PropertyId)
+        };
+
+        var pageRows = await orderedRows
+            .Skip(criteria.Offset)
+            .Take(criteria.PageSize)
+            .ToListAsync(cancellationToken);
+        var representativeRoomIds = pageRows
+            .Where(row => row.RepresentativeRoomId.HasValue)
+            .Select(row => row.RepresentativeRoomId!.Value)
+            .ToArray();
+
+        var amenityRows = await _context.RoomAmenities
+            .AsNoTracking()
+            .Where(link => representativeRoomIds.Contains(link.RoomId))
+            .OrderBy(link => link.RoomId)
+            .ThenBy(link => link.AmenityId)
+            .Select(link => new
+            {
+                link.RoomId,
+                AmenityId = link.Amenity!.AmenityId,
+                link.Amenity.Name
+            })
+            .ToListAsync(cancellationToken);
+
+        var amenitiesByRoom = amenityRows
+            .GroupBy(link => link.RoomId)
+            .ToDictionary(
+                group => group.Key,
+                group => (IReadOnlyList<PublicAmenitySummaryDto>)group
+                    .Take(MaximumAmenitiesSummary)
+                    .Select(link => new PublicAmenitySummaryDto(link.AmenityId, link.Name))
+                    .ToArray());
+
+        var items = pageRows
+            .Select(row => new PublicPropertyCardDto(
+                row.PropertyId,
+                row.PropertyName,
+                row.AddressText,
+                row.Ward,
+                row.District,
+                row.City,
+                null,
+                row.RepresentativeRoomId is int roomId && amenitiesByRoom.TryGetValue(roomId, out var amenities)
+                    ? amenities
+                    : Array.Empty<PublicAmenitySummaryDto>(),
+                row.AvailableRoomCount,
+                row.StartingPrice))
+            .ToArray();
+
+        if (transaction is not null)
+        {
+            await transaction.CommitAsync(cancellationToken);
+        }
+
+        return new PublicPropertyPageDto(items, totalCount, criteria.Page, criteria.PageSize);
+    }
+
+    private static IQueryable<Rooms> ApplyRoomFilters(
+        IQueryable<Rooms> rooms,
+        PublicPropertySearchCriteria criteria)
+    {
+        if (criteria.MinPrice is decimal minPrice)
+        {
+            rooms = rooms.Where(room => room.RoomType!.Price >= minPrice);
+        }
+        if (criteria.MaxPrice is decimal maxPrice)
+        {
+            rooms = rooms.Where(room => room.RoomType!.Price <= maxPrice);
+        }
+        if (criteria.RoomTypeName is not null)
+        {
+            var roomTypeName = criteria.RoomTypeName.ToLowerInvariant();
+            rooms = rooms.Where(room => room.RoomType!.TypeName.Trim().ToLower() == roomTypeName);
+        }
+
+        foreach (var amenityId in criteria.AmenityIds)
+        {
+            rooms = rooms.Where(room => room.RoomAmenities.Any(link => link.AmenityId == amenityId));
+        }
+
+        return rooms;
+    }
+
+    private static IQueryable<Property> ApplyPropertyFilters(
+        IQueryable<Property> properties,
+        PublicPropertySearchCriteria criteria)
+    {
+        if (criteria.Keyword is not null)
+        {
+            var keyword = criteria.Keyword.ToLowerInvariant();
+            properties = properties.Where(property =>
+                property.PropertyName.ToLower().Contains(keyword) ||
+                property.AddressText.ToLower().Contains(keyword) ||
+                property.Ward.ToLower().Contains(keyword) ||
+                property.District.ToLower().Contains(keyword) ||
+                property.City.ToLower().Contains(keyword));
+        }
+
+        if (criteria.City is not null)
+        {
+            var city = criteria.City.ToLowerInvariant();
+            properties = properties.Where(property => property.City.Trim().ToLower() == city);
+        }
+        if (criteria.District is not null)
+        {
+            var district = criteria.District.ToLowerInvariant();
+            properties = properties.Where(property => property.District.Trim().ToLower() == district);
+        }
+        if (criteria.Ward is not null)
+        {
+            var ward = criteria.Ward.ToLowerInvariant();
+            properties = properties.Where(property => property.Ward.Trim().ToLower() == ward);
+        }
+
+        return properties;
+    }
+}
